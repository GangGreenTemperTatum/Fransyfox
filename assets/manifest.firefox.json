{
  "manifest_version": 3,
  "name": "Fransyfox",
  "description": "postMessage transceiver: intercept, track, and analyze cross-frame postMessage listeners and messages",
  "version": "0.2.2",
  "author": "Fransyfox contributors",
  "homepage_url": "https://github.com/GangGreenTemperTatum/Fransyfox",
  "browser_specific_settings": {
    "gecko": {
      "id": "fransyfox@GangGreenTemperTatum.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "130.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fransyfox - PostMessage Tracker",
    "default_area": "navbar"
  },
  "sidebar_action": {
    "default_title": "Fransyfox",
    "default_panel": "panel.html"
  },
  "devtools_page": "devtools.html",
  "permissions": ["tabs", "storage", "scripting", "webNavigation"],
  "host_permissions": ["*://*/*"]
}